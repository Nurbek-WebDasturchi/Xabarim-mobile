{
  "expo": {
    "name": "Xabarim",
    "slug": "xabarim-mobile",
    "version": "0.9.1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "scheme": "xabarim",
    "orientation": "portrait",
    "icon": "./assets/xabarim-logo.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "uz.xabarim.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#5848E8",
        "foregroundImage": "./assets/xabarim-logo.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.xabarim.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "58c7c926-0fd6-48a0-8898-f150ecf4f446"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/58c7c926-0fd6-48a0-8898-f150ecf4f446",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "owner": "ahmedov.provides"
  }
}
